      deleted: false
      plugins: {}
  112eb717-0370-4b30-b53d-1a080b8449d9:
    id: 112eb717-0370-4b30-b53d-1a080b8449d9
    content: Not acceptance criteria — surfaced here so engineering inherits the constraints rather than rediscovering them
    children: []
