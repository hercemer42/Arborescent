      deleted: false
      plugins: {}
  1eee5e3f-76f0-40d2-936a-021fda4b9ddf:
    id: 1eee5e3f-76f0-40d2-936a-021fda4b9ddf
    content: 'Shipped: panel highlight rendering. Feedback init applies `metadata.feedbackBaselineKind` (and `metadata.feedbackPriorContent` for matched nodes) to each node in the feedback store. `TreeNode` derives an effective change kind at render time (`unchanged` ↔ `modified` flips on text edit by comparing current content to prior content), and applies `feedback-changekind-modified` (blue) or `feedback-changekind-added` (green) classes. Both `acceptFeedbackStrategies` paths strip the new metadata before merging into the main tree so it never lands in `.arbo`.'
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
