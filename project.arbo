  42f79cad-c47f-4fa3-af7f-ab00643ac1a7:
    id: 42f79cad-c47f-4fa3-af7f-ab00643ac1a7
    content: Implementation constraints discovered during design
    children:
      - 112eb717-0370-4b30-b53d-1a080b8449d9
      - 90858539-e014-48ab-bce8-aa29d2af7682
      - cb3cb1f1-213d-4a36-994d-f5a0eb0223c5
      - 8f0989df-1bf6-49d3-97a1-e20caa4382d7
    metadata:
      status: completed
