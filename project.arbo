      deleted: false
      plugins: {}
  3ba660a8-a2db-42e3-879d-076014cc3156:
    id: 3ba660a8-a2db-42e3-879d-076014cc3156
    content: '`docs/workflows.md` "Autonomous step" entry updated: each state''s autonomous behaviour is described (Collaborate replaces content; Collaborate & Execute updates statuses; Execute / Action don''t expect feedback). Also corrected the "default execute context" line to reflect actual behaviour (no context = raw content sent without scaffolding)'
    children: []
    metadata:
      status: completed
