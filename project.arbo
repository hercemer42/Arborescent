    content: 'Input: no change to the public API — showTerminal(), showBrowser(), showFeedback(), closeFeedback(), hidePanel() work as before. The store internally tracks which file is active.'
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
  6b60662a-df91-4b46-9c59-877cb941241a:
    id: 6b60662a-df91-4b46-9c59-877cb941241a
    content: 'Output: activeContent and previousContent are now per-file — reading these returns the value for the currently active file (or null if no file is active)'
