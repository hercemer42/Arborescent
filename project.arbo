  046d1ad1-6663-41fb-b230-391f66332772:
    id: 046d1ad1-6663-41fb-b230-391f66332772
    content: 'Primary: A 3-step workflow (Autonomous → Checkpoint → Manual) — AI finishes step 1, node auto-advances and sends to terminal; AI finishes step 2, workflow pauses with notification; user resumes and advances to step 3 (manual), workflow pauses; user sends manually, AI finishes, workflow completes'
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
  a5f76181-91f4-40ec-91b5-50851ad61aed:
    id: a5f76181-91f4-40ec-91b5-50851ad61aed
    content: 'Secondary: Two nodes run through the same workflow in parallel on separate terminal tabs, each progressing independently'
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
  dbf0c642-d144-405c-bf87-8767d5abc1cb:
    id: dbf0c642-d144-405c-bf87-8767d5abc1cb
    content: 'Secondary: A step has no hook event for 10 minutes — timeout dialog appears offering to dismiss or pause'
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
  b114ac7f-46e5-46fc-9005-152ffdd07ba5:
    id: b114ac7f-46e5-46fc-9005-152ffdd07ba5
    content: 'Secondary: User changes a step type mid-run — when the node arrives at the modified step, the new type is evaluated (not the type at workflow start)'
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
