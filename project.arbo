      deleted: false
      plugins: {}
  40dd8cbc-7b10-44e6-ab7f-7f6a520f2f5d:
    id: 40dd8cbc-7b10-44e6-ab7f-7f6a520f2f5d
    content: 'Highest defect likelihood: browser backward compatibility — the pending-slot-to-active-file handoff during initialization has a narrow window where setActiveFile must know about pending tabs'
    children: []
