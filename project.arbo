  a3ae2119-28ad-4aed-837d-ba0cb2ac623a:
    id: a3ae2119-28ad-4aed-837d-ba0cb2ac623a
    content: Security — arbitrary URI schemes can launch other applications or leak data; keep the allowlist tight and exclude file:// by default.
    children: []
