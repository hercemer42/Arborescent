      deleted: false
      plugins: {}
  e814a4f2-4629-415d-8df9-4df985143fb4:
    id: e814a4f2-4629-415d-8df9-4df985143fb4
    content: Concurrent workflows need ref-counting (or a single shared blocker keyed by active count) so finishing one doesn't release the lock for the others
