      status: completed
      expanded: true
      deleted: false
      plugins: {}
  ff2b4b3a-f61a-4efa-b163-3fbdb06f53ac:
    id: ff2b4b3a-f61a-4efa-b163-3fbdb06f53ac
    content: Stopping the workflow mid-recurse leaves all unprocessed nodes in their current steps — no nodes are lost
    children: []
