  550f0c05-677a-4544-a35d-e23bb53ab9b0:
    id: 550f0c05-677a-4544-a35d-e23bb53ab9b0
    content: '"I want to take a problem statement, have AI break it into user stories, then have each story get specs and tests and code — without me clicking Accept at every step, and without losing my original problem statement in the process."'
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
      isBlueprint: false
  bd4bee12-f9e2-45c0-84fa-b610df86cf89:
