  93e2ec7a-618d-4ebf-8fe9-91b6003a5091:
    id: 93e2ec7a-618d-4ebf-8fe9-91b6003a5091
    content: Ship as a single chunk — inline detection, paste-behaviour change, and export preservation are tightly coupled. Splitting them would either leave the workflow-send problem unsolved (the stated motivation) or require speculative plumbing the user does not see.
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
  102c95d1-8cc7-4742-9f49-bdfbab5e8b47:
    id: 102c95d1-8cc7-4742-9f49-bdfbab5e8b47
    content: Challenges
    children:
      - 1e204dec-466c-4ffc-9132-1dd854c95c06
      - 0a9174d5-5937-4fed-a51f-a0f8cd5449ea
      - 6f6e4d2a-c090-483d-9f35-17ae703af9a7
      - 87b9cd05-cc16-418c-a516-9d792af30261
      - ab14e09e-b8bd-4eb8-9d82-c5150ee31191
