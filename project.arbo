    content: 'Out of scope: forward-compat for older app versions reading newer `.arbo` files (they degrade to defaults — no shadowed field), redesigning the feedback panel itself, changing AI output parsing, layered presets above the booleans'
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
  f6cab48c-cdbc-4cc8-ad17-e25c446a0579:
