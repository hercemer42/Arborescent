      deleted: false
      plugins: {}
  1d8ecc5a-0b26-46f4-be55-1f734f982f60:
    id: 1d8ecc5a-0b26-46f4-be55-1f734f982f60
    content: '`docs/workflow.md` "Send Your Prompt" section updated: the four states are summarised, and the Feedback panel behaviour is keyed off the Collaborate dimension only. Send tooltip wording reflects the new state names'
    children: []
