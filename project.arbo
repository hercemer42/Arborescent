      plugins: {}
  633b8c0f-5c1f-4c6c-80f7-d225ea13c577:
    id: 633b8c0f-5c1f-4c6c-80f7-d225ea13c577
    content: Make `NeedsReview` surface a toast + `notifyWorkflowEvent` at arrival time, independent of step type and entry state, so the user always gets a signal. Keep (or simplify) the deferred autonomous-Stop path so we don't double-notify.
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
  78e5e601-a9ba-4b2b-91a5-23833e410e37:
    id: 78e5e601-a9ba-4b2b-91a5-23833e410e37
    content: 'Non-obvious: the server returns 200 even when the renderer silently drops the event (no terminal mapped, no running node, wrong state). Diagnosis from outside the app can''t distinguish "accepted and surfaced" from "accepted and dropped" — worth promoting those drop-paths from `info` to `warn` while we''re in the file.'
    children: []
