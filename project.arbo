  0f02ecb9-272d-48cf-9770-3838e5e215bd:
    id: 0f02ecb9-272d-48cf-9770-3838e5e215bd
    content: 🔧 Implementation proposal
    children:
      - e87be69c-14bf-49bb-8422-57f01cd2c815
      - a58d7a7f-bbda-464d-9218-96ef16ca93e1
      - 957977eb-5417-4040-8875-53bd2848fec5
    metadata:
      status: completed
      expanded: true
      deleted: false
