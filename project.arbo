  302c07c3-56a7-43cb-8463-dacff274526c:
    id: 302c07c3-56a7-43cb-8463-dacff274526c
    content: Risks
    children:
      - 38c0d413-8de6-4abc-ad13-ab66cf07fa5c
      - 245b3eb6-372e-4a59-9030-5c65b7da9ea1
      - 9d3f17af-f65b-4794-937d-56f47aeb22a0
      - bab2b610-fedf-46b0-9db4-f9704f52d541
    metadata:
      status: completed
      expanded: true
