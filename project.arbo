      status: completed
      expanded: true
      deleted: false
      plugins: {}
  38d2e7ab-677b-4813-9f21-74d9984aa404:
    id: 38d2e7ab-677b-4813-9f21-74d9984aa404
    content: 'Highest impact if failed: click event propagation — if stopPropagation is missing or incorrect, clicking the step number could select the node, trigger editing, or interfere with the tree''s keyboard navigation state'
    children: []
