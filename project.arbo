      plugins: {}
  d2d3a434-80c4-46a1-9fdb-1d66b535329e:
    id: d2d3a434-80c4-46a1-9fdb-1d66b535329e
    content: They go out of screen (off the top)
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
  8bcbec79-e563-4da5-b239-08a6bf96b12d:
