      status: completed
      expanded: true
      deleted: false
      plugins: {}
  12e12740-cdd0-471c-8db9-824827dbb2cb:
    id: 12e12740-cdd0-471c-8db9-824827dbb2cb
    content: On load of a file with zero explicitly applied contexts anywhere, a one-time prompt offers to apply "Basic review" or "Basic execution" at the root. User may dismiss without changes; dismissal is remembered per-file so the prompt does not reappear
    children: []
