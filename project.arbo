  3d7af460-8479-4a9d-88f9-e4deceab4866:
    id: 3d7af460-8479-4a9d-88f9-e4deceab4866
    content: Problem statement
    children:
      - 6fc05ab5-b977-4501-8a5b-b1fd9ff626dc
    metadata:
      status: completed
      expanded: true
