  3805d56c-722d-4a3b-a5bb-91b1ced222b7:
    id: 3805d56c-722d-4a3b-a5bb-91b1ced222b7
    content: Recurse processes only the decomposed siblings of the current decomposition point — it does not walk back to earlier autonomous steps
    children: []
