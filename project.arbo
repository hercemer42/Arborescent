  001867b7-c842-4e62-8328-9db3914aedbe:
    id: 001867b7-c842-4e62-8328-9db3914aedbe
    content: Flag complications
    children:
      - 54465ba7-894f-4245-be88-4ab9cd2aa8d5
      - 9c0a3b06-d14b-470c-b468-8f19c2435ded
      - e1b64122-f85e-46eb-a27c-d73eb3a3e6dd
      - 203834c5-5ed3-4605-a46d-9b3d8cfb84cc
      - 9d1dadfd-0eb4-453c-8e19-051019f6818a
