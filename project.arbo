  c88262d6-21ba-41bd-aab7-51b96d0ed062:
    id: c88262d6-21ba-41bd-aab7-51b96d0ed062
    content: 'Follow VS Code model: built-in extensions use same API as marketplace extensions, all can be disabled by users'
    children: []
    metadata:
      status: completed
  970270c0-d817-4e71-83f4-f540cffd4673:
    id: 970270c0-d817-4e71-83f4-f540cffd4673
    content: 'Directory structure: src/renderer/plugins/ with core/ (registry, interface, context), builtin/ (ships with app), external/ (future user-installed)'
    children: []
    metadata:
      status: completed
  4429d7ba-34ea-48e6-bef4-1dea1c350562:
    id: 4429d7ba-34ea-48e6-bef4-1dea1c350562
    content: 'Each plugin has manifest.json: { name, version, displayName, enabled: true, builtin: true }'
    children: []
    metadata:
      status: completed
  f4d54505-4c01-48a1-804d-d9afbc27151f:
    id: f4d54505-4c01-48a1-804d-d9afbc27151f
    content: 'Plugin interface defines standard API: initialize(), dispose(), getContextMenuItems(), getSessions(), sendToSession(), getNodeIndicator()'
    children: []
    metadata:
      status: completed
  cf30ace6-5743-47c9-ad11-33506bb23c09:
    id: cf30ace6-5743-47c9-ad11-33506bb23c09
    content: 'Process isolation: plugins run separately from UI (like VS Code extension host)'
    children: []
    metadata:
      status: completed
      expanded: true
