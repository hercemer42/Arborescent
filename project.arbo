      status: completed
      expanded: true
      deleted: false
      plugins: {}
  4c187957-b5bb-497b-a15f-1099f8fe95c8:
    id: 4c187957-b5bb-497b-a15f-1099f8fe95c8
    content: 'The collaborating node is the root node of the file: multi-root acceptance would need to create multiple root nodes, which the tree doesn''t support (single root per file). This should be prevented — decomposition mode should be ignored if the collaborating node is the file''s root, or the validation should reject multi-root when collaborating on the root node.'
