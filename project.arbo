      status: completed
      expanded: true
      deleted: false
      plugins: {}
      resolvedAt: '2026-02-18T09:21:21.550Z'
  7357da0d-95c7-4505-aefb-e463c40403bf:
    id: 7357da0d-95c7-4505-aefb-e463c40403bf
    content: All arbo files including blueprints are in YAML format and human readable, so you can commit arbo files to your git projects and review the changes with your colleauges.
    children: []
