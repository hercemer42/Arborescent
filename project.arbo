  9e8bbe40-31de-4c4d-96b8-5ce514f35da0:
    id: 9e8bbe40-31de-4c4d-96b8-5ce514f35da0
    content: Complications
    children:
      - 117e9ccc-9df6-49a6-a8ac-fc0d3f611e97
      - f4e530cc-61ee-4432-8f32-1ea7f869e1fc
      - 5146bb8f-a818-4f0b-9469-4017b5a5a94e
      - bbd79fdc-d4b4-4ab6-8735-d1037b463ab3
      - 303a4dfd-e5bc-4a4a-8540-e6563c7ce444
