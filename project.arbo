  ecec26aa-c416-4bec-a86f-25a6af58d13e:
    id: ecec26aa-c416-4bec-a86f-25a6af58d13e
    content: Technical refinement
    children:
      - f7106618-6743-4173-938e-05fe2dddb225
      - 2003956d-2a9a-421f-8f7a-467af0a69fce
    metadata:
