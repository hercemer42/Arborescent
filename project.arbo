    id: 261131f1-c1f1-4580-be37-1fb3f1b4154f
    content: ROI is moderate — pays off when running multiple terminal sessions concurrently; invisible to single-terminal users. Cost is small (one selector + one CSS rule), so acceptable.
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
  0db255a4-3f6a-478d-ab6c-95fc95c5e37c:
