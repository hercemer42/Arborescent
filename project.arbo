    content: Priority indicator test — TabBar resolves priority (actionRequired > feedbackPending > workflowRunning) before passing to Tab. Tab receives a single indicator type, not multiple flags. The priority logic is tested implicitly via TabBar wiring.
    children: []
    metadata:
      status: abandoned
      expanded: true
      deleted: false
      plugins: {}
