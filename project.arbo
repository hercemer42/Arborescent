      plugins: {}
  71d20aa1-2461-468c-b08e-31d1e41d751d:
    id: 71d20aa1-2461-468c-b08e-31d1e41d751d
    content: Recurse works independently of archiving — it processes whatever nodes are sitting in a step, regardless of how they got there
    children: []
