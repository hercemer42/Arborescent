      deleted: false
      plugins: {}
  6d554af0-78ae-448c-8f8d-b3be2ebf0d65:
    id: 6d554af0-78ae-448c-8f8d-b3be2ebf0d65
    content: Complexity worth calling out
    children:
      - 320ffccc-77ba-440b-ac91-1e204ec52f94
      - f1dcf138-0e47-4f90-ab4c-3c4ee1abf0b6
    metadata:
      status: completed
