      status: pending
      expanded: true
      deleted: false
      plugins: {}
  a6968141-6a7d-4b7e-bf4e-58a4286b62ac:
    id: a6968141-6a7d-4b7e-bf4e-58a4286b62ac
    content: A new flag on WorkflowExecutionEntry tracks collaborate mode. The Stop hook checks this flag and defers advancement. The file watcher triggers auto-accept when content arrives. Whichever arrives second triggers advancement.
    children: []
    metadata:
      status: pending
      expanded: true
      deleted: false
      plugins: {}
