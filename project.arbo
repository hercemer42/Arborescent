      deleted: false
      plugins: {}
  3b1fff82-c71d-4837-9a5e-632a2f7d1044:
    id: 3b1fff82-c71d-4837-9a5e-632a2f7d1044
    content: 'AcceptFeedbackCommand undo with multi-root: the snapshot must capture the parent''s children array (to restore collaborating node''s position) and all created sibling subtrees (to remove them). More complex than single-root undo but follows the same pattern.'
