    content: Variable depending on where on the screen the node you right click on is
    children: []
    metadata:
      status: completed
      expanded: true
      deleted: false
      plugins: {}
  0d4e12af-e783-4d5e-86f9-b97fb799789e:
    id: 0d4e12af-e783-4d5e-86f9-b97fb799789e
    content: Let's display the execute and collaborate contexts side by side each in their own box rather than one on top of the other, that'll save some space
    children: []
