      status: completed
      expanded: true
      deleted: false
      plugins: {}
  0fc4b662-b725-4068-9996-0d95268a085b:
    id: 0fc4b662-b725-4068-9996-0d95268a085b
    content: Out of scope for a bug fix — adding a new "Done" terminal state, reworking the two-state (running / awaiting-validation) model, or changing the indicator UX. The fix should land on the existing completion path, not redesign it.
